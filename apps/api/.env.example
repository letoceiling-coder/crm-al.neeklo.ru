DATABASE_URL="postgresql://ai_gateway:ai_gateway_secret@localhost:5432/ai_gateway?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production-use-long-random-string"
# Шифрование полного API-ключа для копирования в панели (опционально, иначе JWT_SECRET)
API_KEY_ENCRYPTION_SECRET=""
# AES-256-GCM для EncryptedSecret / ProviderAccount (обязательно в production)
SECRET_ENCRYPTION_KEY="change-me-secret-encryption-key-min-32-chars"
JWT_EXPIRES_IN="7d"
PORT=3001
CORS_ORIGIN="http://localhost:5173"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_DEFAULT_KEY=""
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Максимальный размер JSON-тела (файлы в base64 внутри messages)
BODY_LIMIT=50mb

# Parser (pars-site.neeklo.ru) — server-to-server only
PARSER_BASE_URL="https://pars-site.neeklo.ru"
PARSER_API_KEY=""
PARSER_DEFAULT_TIMEOUT_MS=120000
PARSER_POLL_INTERVAL_MS=4000
PARSER_MAX_POLL_MS=600000
PARSER_MAX_RETRIES=2

# Selectel S3
S3_ENDPOINT="https://s3.ru-3.storage.selcloud.ru"
S3_REGION="ru-3"
S3_BUCKET="crm-al-knowledge"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Bull Board UI path (under /api)
BULL_BOARD_PATH="/admin/queues"
