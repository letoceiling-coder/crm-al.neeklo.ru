DATABASE_URL="postgresql://ai_gateway:ai_gateway_secret@localhost:5432/ai_gateway?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production-use-long-random-string"
# Шифрование полного API-ключа для копирования в панели (опционально, иначе JWT_SECRET)
API_KEY_ENCRYPTION_SECRET=""
JWT_EXPIRES_IN="7d"
PORT=3001
CORS_ORIGIN="http://localhost:5173"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_DEFAULT_KEY=""
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Максимальный размер JSON-тела (файлы в base64 внутри messages)
BODY_LIMIT=50mb
