generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  DEVELOPER
  ADMIN
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum ApiKeyStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  LIMIT_EXCEEDED
}

enum ModelLabel {
  FREE
  CHEAP
  FAST
  PREMIUM
  REASONING
  VISION
  CODING
  AGENT
}

enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  TWO_FA_ENABLED
  TWO_FA_DISABLED
  API_KEY_CREATED
  API_KEY_DEACTIVATED
  API_KEY_REGENERATED
  API_KEY_UPDATED
  API_KEY_TOP_UP
  AGENT_CREATED
  AGENT_UPDATED
  AGENT_DELETED
  MODEL_ENABLED
  MODEL_DISABLED
  PRICING_UPDATED
  SETTINGS_CHANGED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  OPENROUTER_KEY_ADDED
  OPENROUTER_KEY_REMOVED
  API_REQUEST
  AGENT_REQUEST
  ERROR
}

enum RequestStatus {
  SUCCESS
  ERROR
  FALLBACK
  RATE_LIMITED
}

enum KeyRoutingMode {
  PROFILE
  CUSTOM
}

enum ApiKeyTopUpType {
  INITIAL
  TOP_UP
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  role         UserRole @default(USER)
  theme        Theme    @default(SYSTEM)
  twoFaEnabled Boolean  @default(false) @map("two_fa_enabled")
  twoFaSecret  String?  @map("two_fa_secret")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  apiKeys   ApiKey[]
  keyModelProfiles KeyModelProfile[]
  apiKeyTopUps ApiKeyTopUp[]
  usageLogs UsageLog[]
  auditLogs AuditLog[]

  @@map("users")
}

model ApiKey {
  id              String       @id @default(cuid())
  userId          String       @map("user_id")
  name            String
  keyHash         String       @unique @map("key_hash")
  keyEncrypted    String?      @map("key_encrypted")
  keyPrefix       String       @map("key_prefix")
  status          ApiKeyStatus @default(ACTIVE)
  comment         String?
  allowedIps      String[]     @default([]) @map("allowed_ips")
  allowedDomains  String[]     @default([]) @map("allowed_domains")
  rateLimit       Int?         @map("rate_limit")
  tokenLimit      BigInt?      @map("token_limit")
  tokensUsed      BigInt       @default(0) @map("tokens_used")
  balanceRub           Decimal  @default(0) @map("balance_rub") @db.Decimal(14, 2)
  spentRub             Decimal  @default(0) @map("spent_rub") @db.Decimal(14, 6)
  pricePerMillionRub   Decimal  @default(0) @map("price_per_million_rub") @db.Decimal(12, 6)
  routingMode          KeyRoutingMode @default(CUSTOM) @map("routing_mode")
  modelProfileId       String?  @map("model_profile_id")
  requestsUsed    Int          @default(0) @map("requests_used")
  lastUsedAt      DateTime?    @map("last_used_at")
  expiresAt       DateTime?    @map("expires_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelProfile KeyModelProfile? @relation(fields: [modelProfileId], references: [id], onDelete: SetNull)
  modelChain  ApiKeyModelChain[]
  pricing     ApiKeyPricing[]
  usageLogs   UsageLog[]
  topUps      ApiKeyTopUp[]

  @@index([userId])
  @@index([keyHash])
  @@index([modelProfileId])
  @@map("api_keys")
}

model ApiKeyTopUp {
  id            String          @id @default(cuid())
  apiKeyId      String          @map("api_key_id")
  userId        String          @map("user_id")
  amountRub     Decimal         @map("amount_rub") @db.Decimal(14, 2)
  balanceBefore Decimal         @map("balance_before") @db.Decimal(14, 2)
  balanceAfter  Decimal         @map("balance_after") @db.Decimal(14, 2)
  type          ApiKeyTopUpType @default(TOP_UP)
  comment       String?
  createdAt     DateTime        @default(now()) @map("created_at")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, createdAt])
  @@index([userId, createdAt])
  @@map("api_key_top_ups")
}

model KeyModelProfile {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  name               String
  slug               String
  description        String?
  pricePerMillionRub Decimal  @default(0) @map("price_per_million_rub") @db.Decimal(12, 6)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chains  KeyModelProfileChain[]
  pricing KeyModelProfilePricing[]
  apiKeys ApiKey[]

  @@unique([userId, slug])
  @@index([userId])
  @@map("key_model_profiles")
}

model KeyModelProfileChain {
  id        String @id @default(cuid())
  profileId String @map("profile_id")
  modelId   String @map("model_id")
  priority  Int

  profile KeyModelProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  model   Model           @relation(fields: [modelId], references: [id])

  @@unique([profileId, priority])
  @@map("key_model_profile_chains")
}

model KeyModelProfilePricing {
  id        String  @id @default(cuid())
  profileId String  @map("profile_id")
  modelId   String  @map("model_id")
  costPrice Decimal @map("cost_price") @db.Decimal(12, 6)
  sellPrice Decimal @map("sell_price") @db.Decimal(12, 6)
  margin    Decimal @db.Decimal(12, 6)
  unit      String  @default("1M tokens")

  profile KeyModelProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  model   Model           @relation(fields: [modelId], references: [id])

  @@unique([profileId, modelId])
  @@map("key_model_profile_pricing")
}

model ApiKeyModelChain {
  id        String @id @default(cuid())
  apiKeyId  String @map("api_key_id")
  modelId   String @map("model_id")
  priority  Int

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  model  Model  @relation(fields: [modelId], references: [id])

  @@unique([apiKeyId, priority])
  @@map("api_key_model_chains")
}

model ApiKeyPricing {
  id           String  @id @default(cuid())
  apiKeyId     String  @map("api_key_id")
  modelId      String  @map("model_id")
  costPrice    Decimal @map("cost_price") @db.Decimal(12, 6)
  sellPrice    Decimal @map("sell_price") @db.Decimal(12, 6)
  margin       Decimal @db.Decimal(12, 6)
  unit         String  @default("1M tokens")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  model  Model  @relation(fields: [modelId], references: [id])

  @@unique([apiKeyId, modelId])
  @@map("api_key_pricing")
}

model Model {
  id              String       @id @default(cuid())
  openrouterId    String       @unique @map("openrouter_id")
  name            String
  provider        String
  description     String?
  contextLength   Int          @map("context_length")
  inputPrice      Decimal      @map("input_price") @db.Decimal(20, 10)
  outputPrice     Decimal      @map("output_price") @db.Decimal(20, 10)
  speed           String?
  capabilities    String[]     @default([])
  labels          ModelLabel[] @default([])
  isEnabled       Boolean      @default(true) @map("is_enabled")
  isFree          Boolean      @default(false) @map("is_free")
  metadata        Json?
  lastSyncedAt    DateTime?    @map("last_synced_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  keyChains       ApiKeyModelChain[]
  pricing         ApiKeyPricing[]
  profileChains   KeyModelProfileChain[]
  profilePricing  KeyModelProfilePricing[]
  agentChains     AgentModelChain[]
  globalFallbacks GlobalFallbackChain[]
  usageLogs       UsageLog[]

  @@index([provider])
  @@index([isEnabled])
  @@map("models")
}

model Agent {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  avatar       String?
  systemPrompt String   @map("system_prompt") @db.Text
  temperature  Float    @default(0.7)
  maxContext   Int      @default(128000) @map("max_context")
  isPublic     Boolean  @default(true) @map("is_public")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  modelChain AgentModelChain[]
  tools      AgentTool[]
  usageLogs  UsageLog[]

  @@map("agents")
}

model AgentModelChain {
  id       String @id @default(cuid())
  agentId  String @map("agent_id")
  modelId  String @map("model_id")
  priority Int

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  model Model @relation(fields: [modelId], references: [id])

  @@unique([agentId, priority])
  @@map("agent_model_chains")
}

model AgentTool {
  id          String  @id @default(cuid())
  agentId     String  @map("agent_id")
  name        String
  description String?
  config      Json?

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agent_tools")
}

model OpenRouterKey {
  id        String   @id @default(cuid())
  name      String
  keyHash   String   @map("key_hash")
  keyPrefix String   @map("key_prefix")
  balance   Decimal? @db.Decimal(12, 4)
  isActive  Boolean  @default(true) @map("is_active")
  isDefault Boolean  @default(false) @map("is_default")
  lastCheckedAt DateTime? @map("last_checked_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("openrouter_keys")
}

model GlobalFallbackChain {
  id       String @id @default(cuid())
  modelId  String @map("model_id")
  priority Int

  model Model @relation(fields: [modelId], references: [id])

  @@unique([priority])
  @@map("global_fallback_chains")
}

model UsageLog {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  apiKeyId        String?       @map("api_key_id")
  agentId         String?       @map("agent_id")
  modelId         String?       @map("model_id")
  modelUsed       String        @map("model_used")
  profileSlug     String?       @map("profile_slug")
  inputTokens     Int           @default(0) @map("input_tokens")
  outputTokens    Int           @default(0) @map("output_tokens")
  totalTokens     Int           @default(0) @map("total_tokens")
  realCost        Decimal       @default(0) @map("real_cost") @db.Decimal(12, 6)
  userCost        Decimal       @default(0) @map("user_cost") @db.Decimal(12, 6)
  margin          Decimal       @default(0) @db.Decimal(12, 6)
  responseTimeMs  Int           @default(0) @map("response_time_ms")
  status          RequestStatus @default(SUCCESS)
  errorMessage    String?       @map("error_message")
  fallbackUsed    Boolean       @default(false) @map("fallback_used")
  requestPath     String?       @map("request_path")
  ipAddress       String?       @map("ip_address")
  createdAt       DateTime      @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id])
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id])
  agent  Agent?  @relation(fields: [agentId], references: [id])
  model  Model?  @relation(fields: [modelId], references: [id])

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([modelId, createdAt])
  @@index([agentId, createdAt])
  @@index([createdAt])
  @@map("usage_logs")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?     @map("user_id")
  action     AuditAction
  entityType String?     @map("entity_type")
  entityId   String?     @map("entity_id")
  details    Json?
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
